{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stageport.example/schema/SPC_PC8_Equity_Proof.schema.json",
  "title": "SPC_PC8_Equity_Proof",
  "description": "Data-minimized, no-PII artifact proving social equity conditions through physical access friction and isotropic studio geometry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "naab_standard",
    "studio_id",
    "timestamp",
    "proof_method",
    "privacy_level",
    "isotropic_index",
    "spatial_friction_log",
    "demographic_blind_hash",
    "signature"
  ],
  "properties": {
    "artifact_type": {
      "const": "STAGEPORT_SOVEREIGN_PROOF"
    },
    "naab_standard": {
      "type": "string",
      "examples": ["2020_Conditions_PC.8_Social_Equity"]
    },
    "studio_id": {
      "type": "string",
      "minLength": 3
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "proof_method": {
      "type": "string",
      "enum": ["ISOTROPIC_ACCESS_AUDIT"]
    },
    "privacy_level": {
      "type": "string",
      "enum": ["MAXIMUM_NO_PII"]
    },
    "isotropic_index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "definition", "passing_threshold"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "definition": {
          "type": "string",
          "minLength": 10
        },
        "passing_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "spatial_friction_log": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone_id",
          "access_width_mm",
          "ada_compliant",
          "friction_coefficient"
        ],
        "properties": {
          "zone_id": {
            "type": "string",
            "minLength": 2
          },
          "access_width_mm": {
            "type": "integer",
            "minimum": 0
          },
          "ada_compliant": {
            "type": "boolean"
          },
          "friction_coefficient": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "demographic_blind_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_size", "diversity_entropy_score", "method"],
      "properties": {
        "cohort_size": {
          "type": "integer",
          "minimum": 1
        },
        "diversity_entropy_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditor", "hash"],
      "properties": {
        "auditor": {
          "type": "string",
          "minLength": 3
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
