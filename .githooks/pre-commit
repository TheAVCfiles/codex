#!/usr/bin/env bash
set -euo pipefail

staged_files="$(git diff --cached --name-only)"

if [[ -z "$staged_files" ]]; then
  exit 0
fi

block_regex='(^|/)\.env($|\.)|(^|/)secrets?($|/)|\.pem$|\.key$|id_rsa$|id_ed25519$|credentials?|api[_-]?key|token|^node_modules/'

while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  if [[ "$file" =~ $block_regex ]]; then
    echo "Blocked commit: staged file looks sensitive or unsafe: $file"
    exit 1
  fi
done <<< "$staged_files"

if echo "$staged_files" | grep -q '^package-lock\.json$' && ! echo "$staged_files" | grep -q '^package\.json$'; then
  echo "Warning: package-lock.json changed without package.json. Verify this is intentional."
fi

exit 0
